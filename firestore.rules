rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // REPLACE UID ONLY AFTER TESTING. Default denies everyone.
    function isTeacher() {
      return request.auth != null && request.auth.uid == 'REPLACE_WITH_TEACHER_UID';
    }
    match /teacherEvidence/{recordId} {
      allow read: if isTeacher();
      allow create: if isTeacher()
        && request.resource.data.keys().hasOnly(['date','block','skill','disposition','attempts','helps','firstAttempt','correct','standard','seconds','source','createdAt'])
        && request.resource.data.date is string
        && request.resource.data.date.size() <= 40
        && request.resource.data.block is int
        && request.resource.data.block >= 1
        && request.resource.data.block <= 7
        && request.resource.data.skill is string
        && request.resource.data.skill.size() <= 100
        && request.resource.data.disposition is string
        && request.resource.data.disposition.size() <= 50
        && request.resource.data.attempts is int
        && request.resource.data.attempts >= 0
        && request.resource.data.attempts <= 100
        && request.resource.data.helps is int
        && request.resource.data.helps >= 0
        && request.resource.data.helps <= 100
        && request.resource.data.firstAttempt is bool
        && request.resource.data.correct is bool
        && request.resource.data.standard is string
        && request.resource.data.standard.size() <= 150
        && request.resource.data.seconds is int
        && request.resource.data.seconds >= 0
        && request.resource.data.seconds <= 86400
        && request.resource.data.source == 'teacher-import'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
