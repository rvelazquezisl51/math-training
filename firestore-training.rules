// Add these matches INSIDE the existing /databases/{database}/documents block.
function trainingTeacher() {
  return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
}

match /trainingConfig/{docId} {
  allow read: if request.auth != null;
  allow create, update, delete: if trainingTeacher();
}

match /trainingSessions/{sessionId} {
  allow create: if request.auth != null
                && request.auth.token.firebase.sign_in_provider == 'anonymous'
                && request.resource.data.uid == request.auth.uid;
  allow read: if trainingTeacher() || (request.auth != null && resource.data.uid == request.auth.uid);
  allow update: if request.auth != null
                && request.auth.token.firebase.sign_in_provider == 'anonymous'
                && resource.data.uid == request.auth.uid
                && request.resource.data.uid == resource.data.uid
                && request.resource.data.studentName == resource.data.studentName;
  allow delete: if trainingTeacher();

  match /responses/{responseId} {
    allow create: if request.auth != null
                  && request.auth.token.firebase.sign_in_provider == 'anonymous'
                  && get(/databases/$(database)/documents/trainingSessions/$(sessionId)).data.uid == request.auth.uid;
    allow read: if trainingTeacher() || (request.auth != null
                && get(/databases/$(database)/documents/trainingSessions/$(sessionId)).data.uid == request.auth.uid);
    allow update, delete: if trainingTeacher();
  }
}
